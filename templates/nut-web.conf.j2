# Managed by Ansible (ups.yml): NUT's read-only status page.
# Everything except the status page (and its graphs) gets 403, including upsset.cgi.

url.redirect = ( "^/$" => "/cgi-bin/nut/upsstats.cgi" )

$HTTP["url"] !~ "^/(cgi-bin/nut/ups(stats|image)\.cgi)?$" {
  url.access-deny = ( "" )
}

